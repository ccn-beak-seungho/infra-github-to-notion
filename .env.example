# ── GitHub ───────────────────────────────────────────────
# Fine-grained PAT 권장. 필요한 권한: Repository permissions → Metadata: Read-only
# (비공개 레포를 포함하려면 토큰의 Repository access 에 해당 레포들이 포함되어야 함)
GITHUB_TOKEN=
GITHUB_ORG=

# ── 매칭 규칙 (둘 중 하나만) ─────────────────────────────
# REGEX 가 설정되면 PREFIX 는 무시된다. 둘 다 비면 실행이 실패한다(안전장치).
REPO_NAME_PREFIX=
REPO_NAME_REGEX=

# ── Notion ───────────────────────────────────────────────
# https://www.notion.so/profile/integrations 에서 발급 (ntn_ 로 시작)
NOTION_API_KEY=

# init 잡으로 DB를 만들 때만 필요. 만든 뒤에는 비워도 된다.
NOTION_PARENT_PAGE_ID=

# DB 생성 옵션 (init 잡 전용, 람다에는 전달되지 않음)
# NOTION_DB_INLINE=true  : 페이지 본문에 embed 되는 인라인 DB (기본)
# NOTION_DB_INLINE=false : 독립된 전체 페이지형 DB
NOTION_DB_INLINE=true
# 비우면 "{조직명} Repositories" 가 된다.
NOTION_DB_TITLE=

# init 잡이 출력해주는 값을 여기에 채운다.
NOTION_REPO_DB_ID=
NOTION_REPO_DATA_SOURCE_ID=

# ── 옵션 ─────────────────────────────────────────────────
INCLUDE_FORKS=true
INCLUDE_ARCHIVED=true
ARCHIVE_UNMATCHED=false
DRY_RUN=false

# ── Slack 실패 알림 (선택) ───────────────────────────────
# 둘 다 채워야 동작한다. 비워두면 알림 없이 조용히 넘어간다.
# notion-to-slack 프로젝트의 봇 토큰을 재사용해도 된다.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
